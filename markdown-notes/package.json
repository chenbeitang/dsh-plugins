{
  "name": "@local/markdown-notes",
  "version": "1.4.0",
  "private": true,
  "description": "Markdown 笔记管理器：左侧栏入口，本地目录树、图片与富文本、收藏、左右分栏双端可编辑；支持可拖动分栏、图片缩放、同步滚动与字符级双端光标提示。",
  "type": "module",
  "icon": "icon.svg",
  "keywords": ["dsh", "dsh-plugin", "markdown", "notes", "editor"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "build.mjs",
    "src",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "tests"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
